# Environment variables for AAROH Smart Logistics Platform

# Database Configuration
# Use PostgreSQL with PostGIS in production
# DATABASE_URL=postgresql://user:password@localhost:5432/ner_logistics
DATABASE_URL=sqlite:///./ner_logistics.db

# Application Configuration
APP_TITLE="AI-Based Smart Logistics & Accessibility Intelligence Platform (NER)"
APP_VERSION="1.0.0"
APP_DEBUG=true

# Security (Future use)
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# GIS & Mapping (Future use)
# MAPBOX_ACCESS_TOKEN=your-mapbox-token
# OSM_API_URL=https://nominatim.openstreetmap.org

# Weather API (Future use)
# WEATHER_API_KEY=your-weather-api-key
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Firebase (Future use)
# FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json
